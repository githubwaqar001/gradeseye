<?xml version="1.0" encoding="utf-8"?>
<!-- Section 1/17/22: keep all traffic on HTTPS to the existing Google Drive/Apps Script/Sheets backend; no plaintext exceptions. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
